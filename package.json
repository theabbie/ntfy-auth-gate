{
  "name": "ntfy-auth-gate",
  "version": "0.1.1",
  "description": "approve api requests from your phone with ntfy, as a drop-in middleware for node servers",
  "license": "MIT",
  "author": "theabbie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theabbie/ntfy-auth-gate.git"
  },
  "homepage": "https://github.com/theabbie/ntfy-auth-gate#readme",
  "bugs": {
    "url": "https://github.com/theabbie/ntfy-auth-gate/issues"
  },
  "keywords": [
    "ntfy",
    "auth",
    "middleware",
    "express",
    "approval",
    "push-notification",
    "2fa",
    "ciba"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm run check && npm test"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "express": "^5.3.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
